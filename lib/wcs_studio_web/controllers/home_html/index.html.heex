<section
  id="hero-carousel"
  phx-hook="Carousel"
  class="relative w-full overflow-hidden h-screen -mt-16"
>
  <div id="carousel" class="flex transition-transform duration-700 ease-in-out h-full">
    <!-- Slide 1 -->
    <div class="min-w-full flex-shrink-0 relative h-full">
      <div class="absolute inset-0 bg-gradient-to-br from-surface-base via-hero-ambient-1 to-surface-base">
      </div>
      <div class="absolute inset-0 bg-black opacity-40"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-brand-from/10 to-brand-to/10"></div>
      <div class="absolute inset-0 flex flex-col justify-center items-start text-left px-8 md:px-16 lg:px-24">
        <h2 class="text-5xl md:text-7xl lg:text-8xl font-bold text-strong mb-6 opacity-0 animate-[slideUp_0.8s_ease-out_0.2s_forwards]">
          {gettext("Dance ")}<span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-lightFrom to-brand-lightTo">{gettext(
            "Elevated"
          )}</span>
        </h2>
        <p class="text-xl md:text-2xl text-body mb-8 max-w-2xl opacity-0 animate-[slideUp_0.8s_ease-out_0.4s_forwards]">
          {gettext("Master the art of movement comprehensive resources")}
        </p>
      </div>
    </div>

    <!-- Slide 2 -->
    <div class="min-w-full flex-shrink-0 relative h-full">
      <div class="absolute inset-0 bg-gradient-to-br from-hero-ambient-1 via-hero-ambient-2 to-surface-base">
      </div>
      <div class="absolute inset-0 bg-black opacity-30"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-brand-from/10 to-brand-to/10"></div>
      <div class="absolute inset-0 flex flex-col justify-center items-start text-left px-8 md:px-16 lg:px-24">
        <h2 class="text-5xl md:text-7xl lg:text-8xl font-bold text-strong mb-6 opacity-0 animate-[slideUp_0.8s_ease-out_0.2s_forwards]">
          {gettext("Perfect Your")}
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-lightFrom to-brand-lightTo">
            {gettext("Technique")}
          </span>
        </h2>
        <p class="text-xl md:text-2xl text-body mb-8 max-w-2xl opacity-0 animate-[slideUp_0.8s_ease-out_0.4s_forwards]">
          {gettext("Step-by-step patterns and some instruction for dancers at admin level")}
        </p>
      </div>
    </div>

    <!-- Slide 3 -->
    <div class="min-w-full flex-shrink-0 relative h-full">
      <div class="absolute inset-0 bg-gradient-to-br from-surface-base via-hero-ambient-1 to-hero-ambient-2">
      </div>
      <div class="absolute inset-0 bg-black opacity-25"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-brand-from/10 to-brand-to/10"></div>
      <div class="absolute inset-0 flex flex-col justify-center items-start text-left px-8 md:px-16 lg:px-24">
        <h2 class="text-5xl md:text-7xl lg:text-8xl font-bold text-strong mb-6 opacity-0 animate-[slideUp_0.8s_ease-out_0.2s_forwards]">
          {gettext("Join my ")}<span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-lightFrom to-brand-lightTo">{gettext(
            "Journey"
          )}</span>
        </h2>
        <p class="text-xl md:text-2xl text-body mb-8 max-w-2xl opacity-0 animate-[slideUp_0.8s_ease-out_0.4s_forwards]">
          {gettext("Be up to date with dance styles")}
        </p>
      </div>
    </div>
  </div>

  <!-- Navigation Arrows -->
  <button
    id="prev"
    aria-label={gettext("Previous slide")}
    class="absolute top-1/2 left-2 sm:left-4 p-3 sm:p-4 transform -translate-y-1/2 bg-surface-raised/50 backdrop-blur-sm rounded-md hover:bg-surface-muted/50 border border-surface-muted/50 transition-all duration-300 group z-10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-lightFrom/70"
  >
    <i class="fas fa-chevron-left text-strong text-lg group-hover:scale-110 transition-transform"></i>
  </button>
  <button
    id="next"
    aria-label={gettext("Next slide")}
    class="absolute top-1/2 right-2 sm:right-4 p-3 sm:p-4 transform -translate-y-1/2 bg-surface-raised/50 backdrop-blur-sm rounded-md hover:bg-surface-muted/50 border border-surface-muted/50 transition-all duration-300 group z-10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-lightFrom/70"
  >
    <i class="fas fa-chevron-right text-strong text-lg group-hover:scale-110 transition-transform"></i>
  </button>

  <!-- Indicators -->
  <div class="absolute bottom-4 sm:bottom-8 left-1/2 transform -translate-x-1/2 flex space-x-3 z-10">
    <button
      aria-label={gettext("Go to slide %{number}", number: 1)}
      class="carousel-indicator w-3 h-3 rounded-full bg-white/50 transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-lightFrom/70"
    ></button>
    <button
      aria-label={gettext("Go to slide %{number}", number: 2)}
      class="carousel-indicator w-3 h-3 rounded-full bg-white/50 transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-lightFrom/70"
    ></button>
    <button
      aria-label={gettext("Go to slide %{number}", number: 3)}
      class="carousel-indicator w-3 h-3 rounded-full bg-white/50 transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-lightFrom/70"
    ></button>
  </div>
</section>

<!-- Features / Gallery Section -->
<section class="py-section bg-surface-raised/30">
  <div class="mx-auto max-w-7xl px-4 md:px-8">
    <div class="text-center mb-16 opacity-0 animate-[fadeIn_1s_ease-out_0.2s_forwards]">
      <h2 class="text-4xl md:text-5xl font-bold text-strong mb-4 bg-gradient-to-r from-white to-slate-300 bg-clip-text text-transparent">
        {gettext("Some of my resources about dancing")}
      </h2>
      <p class="text-lg md:text-xl text-muted max-w-3xl mx-auto">
        {gettext("I'm not a pro but I made this page to have one place for dancing content")}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Card 1 -->
      <.feature_card
        href={~p"/dance_types"}
        image={~p"/images/advertisement-51631_1280.webp"}
        image_alt={gettext("Dance styles illustration")}
        icon="fas fa-music"
        title={gettext("Dance Styles")}
        description={gettext("View dance types I came across in my life")}
        cta={gettext("Explore")}
      />

      <.feature_card
        href={~p"/patterns"}
        image={~p"/images/boots-7251230_1280.webp"}
        image_alt={gettext("Dance shoes illustration")}
        icon="fas fa-shapes"
        title={gettext("Steps")}
        description={gettext("Explore complex descriptions of sequences ")}
        cta={gettext("Learn more")}
      />

      <.feature_card
        href={~p"/admin/lessons"}
        image={~p"/images/dance-971082_1280.webp"}
        image_alt={gettext("Dancers illustration")}
        icon="fas fa-play-circle"
        title={gettext("Video Lessons")}
        description={gettext("Available only for admin unless I record my own videos ")}
        cta={gettext("Watch now")}
      />

      <.feature_card
        href={~p"/blog"}
        image={~p"/images/newspaper-664652_1280.jpg"}
        image_alt={gettext("Newspaper illustration")}
        icon="fas fa-newspaper"
        title={gettext("Blog & Insights")}
        description={gettext("Enthusiast insight into dancing techniques ")}
        cta={gettext("Read more")}
      />
    </div>
  </div>
</section>

<!-- Stats Section -->
<section class="py-section bg-surface-raised/50 backdrop-blur-sm border-y border-surface-muted/50">
  <div class="mx-auto max-w-7xl px-4 md:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <div class="text-center">
        <div class="w-20 h-20 rounded-lg bg-gradient-to-br from-brand-from to-brand-to flex items-center justify-center mx-auto mb-4">
          <i class="fas fa-newspaper text-strong text-2xl"></i>
        </div>
        <div class="text-3xl md:text-4xl font-bold text-strong mb-2">{@posts_number}+</div>
        <div class="text-lg text-body font-medium">{gettext("Articles")}</div>
        <div class="text-sm text-muted mt-2">
          {gettext("Madman articles about dancing or something")}
        </div>
      </div>
      <div class="text-center">
        <div class="w-20 h-20 rounded-lg bg-gradient-to-br from-brand-from to-brand-to flex items-center justify-center mx-auto mb-4">
          <i class="fas fa-shapes text-strong text-2xl"></i>
        </div>
        <div class="text-3xl md:text-4xl font-bold text-strong mb-2">{@patterns_number}+</div>
        <div class="text-lg text-body font-medium">{gettext("Patterns")}</div>
        <div class="text-sm text-muted mt-2">{gettext("Detailed breakdowns")}</div>
      </div>
      <div class="text-center">
        <div class="w-20 h-20 rounded-lg bg-gradient-to-br from-brand-from to-brand-to flex items-center justify-center mx-auto mb-4">
          <i class="fas fa-users text-strong text-2xl"></i>
        </div>
        <div class="text-3xl md:text-4xl font-bold text-strong mb-2">{@users_number}+</div>
        <div class="text-lg text-body font-medium">{gettext("Members")}</div>
        <div class="text-sm text-muted mt-2">{gettext("Sort of community")}</div>
      </div>
      <div class="text-center">
        <div class="w-20 h-20 rounded-lg bg-gradient-to-br from-brand-from to-brand-to flex items-center justify-center mx-auto mb-4">
          <i class="fas fa-graduation-cap text-strong text-2xl"></i>
        </div>
        <div class="text-3xl md:text-4xl font-bold text-strong mb-2">{@lessons_number}+</div>
        <div class="text-lg text-body font-medium">{gettext("Lessons")}</div>
        <div class="text-sm text-muted mt-2">{gettext("Not sharable admin only")}</div>
      </div>
    </div>
  </div>
</section>

<!-- Call to Action -->
<section class="py-section ">
  <div class="mx-auto max-w-4xl px-4 md:px-8 text-center">
    <h2 class="text-4xl md:text-5xl font-bold text-strong mb-6 bg-gradient-to-r from-white to-slate-300 bg-clip-text text-transparent">
      {gettext("Ready to Track your progress?")}
    </h2>
    <p class="text-xl md:text-2xl mb-8 text-body">
      {gettext("Join some community mastering their craft through this comprehensive platform")}
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <.button
        href={~p"/users/log_in"}
        variant={:primary}
        size={:lg}
        class="animate-pulse-glow"
      >
        {gettext("Start Learning Today")}
      </.button>
      <.button href={~p"/connect"} variant={:secondary} size={:lg}>
        {gettext("Contact Me")}
      </.button>
    </div>
  </div>
</section>
