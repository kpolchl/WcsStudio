<div class="max-w-6xl mx-auto py-section-sm px-4 space-y-12">
  <.header size={:lg} gradient centered>
    Component Preview
    <:subtitle>Shared UI building blocks, available only in development.</:subtitle>
  </.header>

  <section class="space-y-4">
    <h2 class="text-heading font-bold text-white">Buttons</h2>
    <div class="flex flex-wrap items-center gap-3">
      <.button>Primary</.button>
      <.button variant={:secondary}>Secondary</.button>
      <.button variant={:ghost}>Ghost</.button>
      <.button variant={:danger}>Danger</.button>
      <.button variant={:info}>Info</.button>
      <.button variant={:success}>Success</.button>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <.button size={:sm} variant={:info}>Small</.button>
      <.button size={:lg} variant={:success}>Large</.button>
      <.button href={~p"/"} variant={:ghost}>Link button</.button>
      <.button disabled>Disabled</.button>
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-heading font-bold text-white">Cards</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      <.card>Default card with medium padding.</.card>
      <.card padding={:lg} interactive>
        Large, interactive card with hover treatment.
      </.card>
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-heading font-bold text-white">Icons</h2>
    <div class="flex flex-wrap items-center gap-6 text-white">
      <.icon name="fa-music" class="text-3xl" />
      <.icon name="fa-shapes" class="text-3xl text-brand-lightFrom" />
      <.icon name="fa-spinner" class="fa-spin text-3xl" />
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-heading font-bold text-white">Feature card</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <.feature_card
        href={~p"/patterns"}
        image={~p"/images/boots-7251230_1280.webp"}
        image_alt="Dance shoes illustration"
        icon="fas fa-shapes"
        title="Steps"
        description="Explore complex descriptions of sequences."
        cta="Learn more"
      />
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-heading font-bold text-white">Empty state</h2>
    <.card padding={:none}>
      <.empty_state
        icon="fas fa-dice"
        title="Nothing here yet"
        description="This is how an empty collection looks."
      >
        <:actions>
          <.button variant={:secondary} size={:sm}>Take action</.button>
        </:actions>
      </.empty_state>
    </.card>
  </section>

  <section class="space-y-4">
    <h2 class="text-heading font-bold text-white">Skeleton</h2>
    <.card>
      <.skeleton lines={4} />
    </.card>
  </section>

  <section class="space-y-4">
    <h2 class="text-heading font-bold text-white">Typography tokens</h2>
    <div class="space-y-2 text-white">
      <p class="text-display-sm">Display small</p>
      <p class="text-heading">Heading</p>
      <p class="text-lead text-slate-300">Lead paragraph</p>
      <p class="text-body text-slate-300">Body text</p>
      <p class="text-caption text-slate-400">Caption text</p>
    </div>
  </section>
</div>
