<div class="flex-1 flex items-center justify-center p-4">
  <.card class="w-full max-w-lg text-center">
    <.icon_badge gradient="warn" icon="compass" size="lg" class="mx-auto mb-6 text-2xl" />
    <h1 class="text-3xl font-bold text-white mb-4 bg-gradient-to-r from-white to-slate-300 bg-clip-text text-transparent">
      {gettext("Page not found")}
    </h1>
    <p class="text-base text-slate-300 leading-relaxed mb-8">
      {gettext("The page you are looking for does not exist or has moved.")}
    </p>
    <.btn href={~p"/"}>{gettext("Back home")}</.btn>
  </.card>
</div>
