<nav
  id="main-nav"
  phx-hook="NavActive"
  class="sticky top-0 z-50 backdrop-blur-md bg-surface-base/80 border-b border-surface-muted/50 shadow-raised"
>
  <div class="px-4 mx-auto">
    <div class="flex justify-between h-16">
      <div class="flex items-center">
        <!-- Logo -->
        <div class="flex-shrink-0 flex items-center">
          <.link
            href={~p"/"}
            class="text-2xl font-bold bg-gradient-to-r from-brand-from to-brand-to bg-clip-text text-transparent"
          >
            WcsStudio
          </.link>
        </div>

        <!-- Desktop Navigation -->
        <div class="hidden md:ml-10 md:flex md:items-center md:space-x-1">
          <.nav_link href={~p"/dance_types"}>{gettext("Dance Types")}</.nav_link>
          <.nav_link href={~p"/patterns"}>{gettext("Steps")}</.nav_link>
          <%= if @current_user && @current_user.role == "admin" do %>
            <.nav_link href={~p"/admin/lessons"}>{gettext("Lessons")}</.nav_link>
          <% end %>
          <.nav_link href={~p"/practice"}>{gettext("Practice")}</.nav_link>
          <.nav_link href={~p"/blog"}>{gettext("Blog")}</.nav_link>
          <.nav_link href={~p"/connect"}>{gettext("About me")}</.nav_link>
        </div>
      </div>

      <div class="flex items-center space-x-4">
        <!-- User menu (desktop) -->
        <div class="hidden md:flex items-center space-x-4">
          <.locale_switcher
            current_locale={assigns[:locale] || "pl"}
            current_path={
              if assigns[:conn], do: @conn.request_path, else: assigns[:current_path] || "/"
            }
          />
          <%= if @current_user do %>
            <div
              class="relative"
              id="user-menu-container"
              phx-click-away={JS.add_class("hidden", to: "#user-menu")}
            >
              <button
                type="button"
                phx-click={
                  JS.toggle(
                    to: "#user-menu",
                    in: {"ease-out duration-100", "opacity-0 scale-95", "opacity-100 scale-100"},
                    out: {"ease-in duration-75", "opacity-100 scale-100", "opacity-0 scale-95"}
                  )
                }
                class="flex items-center space-x-3 p-1 rounded-lg hover:bg-surface-raised/50 transition-all duration-300 group border border-transparent hover:border-surface-muted/50"
              >
                <div class="flex flex-col items-end">
                  <span class="text-sm font-medium text-strong">{@current_user.username}</span>
                  <span class="text-xs text-muted">{WcsStudio.Accounts.role_label(
                    @current_user.role
                  )}</span>
                </div>
                <div class="relative" id="user-avatar" phx-update="ignore">
                  <img
                    src={avatar_url(@current_user.profile_pic_url)}
                    alt=" "
                    class="size-8 rounded-full bg-surface-raised outline -outline-offset-1 outline-white/10"
                  />
                  <div class="absolute -bottom-1 -right-1 w-3 h-3 bg-accent-success rounded-full border-2 border-surface-base">
                  </div>
                </div>
                <i class="fas fa-chevron-down text-muted text-xs transition-transform duration-300 group-hover:rotate-180"></i>
              </button>

              <div
                id="user-menu"
                class="hidden absolute right-0 mt-3 w-80 rounded-md bg-surface-raised/95 backdrop-blur-xl border border-surface-muted/50 shadow-card py-2 z-50"
                phx-update="ignore"
              >
                <!-- User Profile Section -->
                <div class="px-4 py-3 border-b border-surface-muted/50">
                  <div class="flex items-center space-x-3">
                    <div class="relative">
                      <div class="w-12 h-12 rounded-full bg-gradient-to-r from-brand-from to-brand-to flex items-center justify-center text-strong font-bold shadow-raised">
                        <img
                          src={avatar_url(@current_user.profile_pic_url)}
                          alt=" "
                          class="size-12 rounded-full bg-surface-raised outline -outline-offset-1 outline-white/10"
                        />
                      </div>
                      <div class="absolute -bottom-1 -right-1 w-3 h-3 bg-accent-success rounded-full border-2 border-surface-raised">
                      </div>
                    </div>
                    <div class="flex-1 min-w-0">
                      <p class="text-sm font-semibold text-strong truncate">
                        {@current_user.username}
                      </p>
                      <p class="text-xs text-muted truncate">{@current_user.email}</p>
                      <div class="flex items-center mt-1">
                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gradient-to-r from-brand-from/20 to-brand-to/20 text-brand-lightFrom border border-brand-from/30">
                          <i class="fas fa-crown text-xs mr-1"></i>
                          {WcsStudio.Accounts.role_label(@current_user.role)}
                        </span>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Menu Items -->
                <div class="py-1">
                  <.link
                    href={~p"/user_profile"}
                    class="flex items-center px-4 py-2 text-sm text-body hover:bg-surface-muted/50 hover:text-strong transition-colors duration-200 group"
                  >
                    <i class="fas fa-user-circle w-5 mr-3 text-muted group-hover:text-accent-info transition-colors duration-200"></i>
                    {gettext("Your Profile")}
                  </.link>
                  <.link
                    href={~p"/users/settings"}
                    class="flex items-center px-4 py-2 text-sm text-body hover:bg-surface-muted/50 hover:text-strong transition-colors duration-200 group"
                  >
                    <i class="fas fa-cog w-5 mr-3 text-muted group-hover:text-accent-info transition-colors duration-200"></i>
                    {gettext("Account Settings")}
                  </.link>
                </div>

                <!-- Divider -->
                <div class="border-t border-surface-muted/50 my-1"></div>

                <!-- Footer Menu Items -->
                <div class="py-1">
                  <.link
                    href={~p"/users/log_out"}
                    method="delete"
                    class="flex items-center px-4 py-2 text-sm text-accent-danger hover:bg-accent-danger/10 transition-colors duration-200 group"
                  >
                    <i class="fas fa-sign-out-alt w-5 mr-3 group-hover:text-accent-danger/80 transition-colors duration-200"></i>
                    {gettext("Sign out")}
                  </.link>
                </div>
              </div>
            </div>
          <% else %>
            <.link
              href={~p"/users/log_in"}
              class="text-body hover:text-strong px-4 py-2 text-sm font-medium transition-colors duration-300"
            >
              {gettext("Log in")}
            </.link>
            <.button href={~p"/users/register"} variant={:primary} size={:sm}>
              {gettext("Register")}
            </.button>
          <% end %>
        </div>

        <!-- Mobile menu button -->
        <div class="md:hidden flex items-center">
          <button
            id="mobile-menu-toggle"
            type="button"
            phx-click={
              JS.toggle(to: "#mobile-menu")
              |> JS.toggle(to: "#menu-icon-open")
              |> JS.toggle(to: "#menu-icon-close")
              |> JS.toggle_attribute({"aria-expanded", "true", "false"},
                to: "#mobile-menu-toggle"
              )
              |> JS.toggle_attribute({"aria-hidden", "false", "true"}, to: "#mobile-menu")
            }
            class="inline-flex items-center justify-center p-2 rounded-md text-muted hover:text-strong hover:bg-surface-raised transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-white"
            aria-label="Open main menu"
            aria-controls="mobile-menu"
            aria-expanded="false"
          >
            <span class="sr-only">Open main menu</span>
            <svg
              id="menu-icon-open"
              class="block h-6 w-6"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"
              />
            </svg>
            <svg
              id="menu-icon-close"
              class="hidden h-6 w-6"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    class="md:hidden hidden backdrop-blur-lg bg-surface-base/95 border-b border-surface-muted/50 shadow-card"
    id="mobile-menu"
    aria-hidden="true"
    phx-click-away={
      JS.add_class("hidden", to: "#mobile-menu")
      |> JS.add_class("hidden", to: "#menu-icon-close")
      |> JS.remove_class("hidden", to: "#menu-icon-open")
      |> JS.set_attribute({"aria-expanded", "false"}, to: "#mobile-menu-toggle")
      |> JS.set_attribute({"aria-hidden", "true"}, to: "#mobile-menu")
    }
  >
    <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
      <.nav_link href={~p"/dance_types"} mobile>{gettext("Dance Types")}</.nav_link>
      <.nav_link href={~p"/patterns"} mobile>{gettext("Steps")}</.nav_link>
      <%= if @current_user && @current_user.role == "admin" do %>
        <.nav_link href={~p"/admin/lessons"} mobile>{gettext("Lessons")}</.nav_link>
      <% end %>
      <.nav_link href={~p"/practice"} mobile>{gettext("Practice")}</.nav_link>
      <.nav_link href={~p"/blog"} mobile>{gettext("Blog")}</.nav_link>
      <.nav_link href={~p"/connect"} mobile>{gettext("About me")}</.nav_link>
      <div class="md:hidden pt-4 border-t border-surface-muted/50 mt-4">
        <.mobile_locale_switcher
          current_locale={assigns[:locale] || "pl"}
          current_path={
            if assigns[:conn], do: @conn.request_path, else: assigns[:current_path] || "/"
          }
        />
      </div>

      <!-- Mobile User Section -->
      <div class="pt-4 pb-3 border-t border-surface-muted mt-4">
        <%= if @current_user do %>
          <div class="flex items-center px-3 py-2">
            <div class="flex-shrink-0">
              <img
                src={avatar_url(@current_user.profile_pic_url)}
                alt={@current_user.username}
                class="h-10 w-10 rounded-full bg-surface-raised outline -outline-offset-1 outline-white/10"
              />
            </div>
            <div class="ml-3">
              <div class="text-base font-medium text-strong">{@current_user.username}</div>
              <div class="text-sm font-medium text-muted">{gettext("Welcome Back!")}</div>
            </div>
          </div>
          <div class="mt-3 px-2 space-y-1">
            <.link
              href={~p"/user_profile"}
              class="block px-3 py-2 rounded-lg text-base font-medium text-muted hover:text-strong hover:bg-surface-raised/50 transition-all duration-300"
            >
              {gettext("Your Profile")}
            </.link>
            <.link
              href={~p"/users/settings"}
              class="block px-3 py-2 rounded-lg text-base font-medium text-muted hover:text-strong hover:bg-surface-raised/50 transition-all duration-300"
            >
              {gettext("Settings")}
            </.link>
            <.link
              href={~p"/users/log_out"}
              method="delete"
              class="block px-3 py-2 rounded-lg text-base font-medium text-muted hover:text-strong hover:bg-surface-raised/50 transition-all duration-300"
            >
              {gettext("Sign out")}
            </.link>
          </div>
        <% else %>
          <div class="mt-3 px-2 space-y-2">
            <.link
              href={~p"/users/log_in"}
              class="block px-3 py-2 rounded-lg text-base font-medium text-body hover:text-strong hover:bg-surface-raised/50 transition-all duration-300 text-center"
            >
              {gettext("Log in")}
            </.link>
            <.button href={~p"/users/register"} variant={:primary} size={:sm} class="w-full">
              {gettext("Register")}
            </.button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</nav>

<main class="flex-1 py-section-sm">
  <.flash_group flash={@flash} />
  {@inner_content}
</main>
